# ==============================================================================
# НАСТРОЙКИ ПРОЕКТА И МИКРОКОНТРОЛЛЕРА
# ==============================================================================

# Имя итогового файла прошивки (получится firmware.hex)
TARGET = firmware

# Тип микроконтроллера для компилятора (atmega8) и для программатора (m8)
MCU = atmega8
MCU_AVRDUDE = m8

# Тактовая частота контроллера в Герцах (1 МГц = 1000000UL)
# Эта цифра передается в код как макрос F_CPU для работы <util/delay.h>
F_CPU = 1000000UL

# Название программатора для avrdude
PROGRAMMER = usbasp

# ==============================================================================
# ПУТИ К ФАЙЛАМ И ПАПКАМ
# ==============================================================================

# Папка с исходным кодом (.c) и заголовочными файлами (.h)
SRC_DIR = src
INC_DIR = include

# Автоматически находим все .c файлы в папке src/
SRCS = $(wildcard $(SRC_DIR)/*.c)

# Формируем список объектных файлов (.o) из списка .c файлов
OBJS = $(SRCS:.c=.o)

# ==============================================================================
# НАСТРОЙКИ КОМПИЛЯТОРА (avr-gcc)
# ==============================================================================

CC = avr-gcc
OBJCOPY = avr-objcopy
SIZE = avr-size

# Флаги компиляции:
# -mmcu=$(MCU)      : собирать код конкретно под архитектуру ATmega8
# -DF_CPU=$(F_CPU)  : передать частоту 1 МГц в код (заменяет #define F_CPU)
# -Os               : оптимизация по размеру кода (критично для 8 КБ памяти ATmega8
#                     и обязательно для корректной работы задержек _delay_us)
# -Wall -Wextra     : включить все предупреждения о потенциальных ошибках в коде
# -I$(INC_DIR)      : искать заголовочные файлы (.h) в папке include/
CFLAGS = -mmcu=$(MCU) -DF_CPU=$(F_CPU) -Os -Wall -Wextra -I$(INC_DIR)

# ==============================================================================
# ПРАВИЛА СБОРКИ И ПРОШИВКИ (Цели)
# ==============================================================================

# Цель по умолчанию (выполняется при вводе команды 'make')
all: $(TARGET).hex size

# 1. Компиляция каждого файла .c в промежуточный объектный файл .o
$(SRC_DIR)/%.o: $(SRC_DIR)/%.c
	$(CC) $(CFLAGS) -c $< -o $@

# 2. Линковка (склейка) всех .o файлов в единый исполняемый файл .elf
$(TARGET).elf: $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) -o $@

# 3. Извлечение из .elf файла чистого машинного кода в формате .hex для заливки в МК
$(TARGET).hex: $(TARGET).elf
	$(OBJCOPY) -O ihex -R .eeprom $< $@

# 4. Вывод статистики: сколько байт Flash и оперативной памяти (SRAM) заняла программа
size: $(TARGET).elf
	$(SIZE) --format=avr --mcu=$(MCU) $(TARGET).elf

# Цель для прошивки микроконтроллера (выполняется командой 'make flash')
flash: $(TARGET).hex
	avrdude -c $(PROGRAMMER) -p $(MCU_AVRDUDE) -U flash:w:$(TARGET).hex:i

# Цель для очистки папки от временных файлов сборки (команда 'make clean')
clean:
	rm -f $(SRC_DIR)/*.o $(TARGET).elf $(TARGET).hex
